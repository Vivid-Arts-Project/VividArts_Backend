# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://localhost:3001

# Team database configuration. Keep DB_DIALECT=mysql for development parity.
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=replace-with-your-local-password
DB_NAME=vivid_arts

# Admin sessions. Generate a long random value for each environment.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Used to sign customer login tokens. Generate a long random value for each environment.
JWT_SECRET=replace-with-at-least-32-random-characters

# SMTP email notifications
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true.
# Use an app password for SMTP_PASS; do not use or commit your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="Vivid Arts <your-email@example.com>"

# Registration email verification codes expire after 10 minutes.

# PayHere Checkout
# Use credentials from the same PayHere environment selected below. The
# Merchant Secret is specific to the approved domain/app; it is not the
# account password or a Merchant API App Secret.
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=replace-with-7-digit-sandbox-merchant-id
PAYHERE_MERCHANT_SECRET=replace-with-approved-domain-merchant-secret
PAYHERE_ALLOWED_CURRENCIES=LKR
# PayHere cannot post payment results to localhost. Keep FRONTEND_URL and
# BACKEND_URL local if desired, but expose this callback through ngrok.
PAYHERE_NOTIFY_URL=https://your-ngrok-domain.ngrok-free.dev/api/payments/payhere-notify
# Optional guard against using a secret with the wrong frontend domain.
# This must match the hostname in FRONTEND_URL and the domain approved by PayHere.
PAYHERE_INTEGRATION_DOMAIN=localhost
